# Copy this file to .env (same folder) and fill in your own values.
# .env is git-ignored, so your passwords never reach the repository.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=postgres
DB_PASSWORD=
# true only if your server requires SSL (most hosted databases do).
DB_SSL=false

# Redis
# Redis Cloud: open your database in the Redis Cloud console, click
# "Connect" and copy its redis://... URL (it includes the password), e.g.
#   REDIS_URL=redis://default:PASSWORD@redis-12345.c1.ap-south-1-1.ec2.redns.redis-cloud.com:12345
# Use rediss:// (two s's) if TLS is turned on for the database. Pasting the
# whole "redis-cli -u redis://..." command from that panel works too.
REDIS_URL=
# Only for a local Redis - ignored when REDIS_URL is set.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# API server
SERVER_PORT=8080
# Which web origins may call the API from a browser; * allows any (fine on
# your own machine, narrow it before putting the server online).
CORS_ORIGIN=*
# "Today", the 7-day trend and the other sales periods start at midnight
# in this time zone.
TIME_ZONE=Asia/Karachi
